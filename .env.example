# Optional local overrides. Copy to .env only for Docker Compose; export values
# explicitly for host processes. Never put a real broker credential in this file.

# Local database and non-authoritative queue/cache infrastructure.
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@127.0.0.1:5432/portfolio
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Shared security settings. Synthetic authentication is restricted to loopback
# local/test use; staging/production requires issuer/audience/key references.
T212PI_ENVIRONMENT=local
T212PI_LOCAL_SYNTHETIC_AUTH_ENABLED=true
T212PI_COOKIE_SECURE=false
T212PI_COOKIE_HTTP_ONLY=true
T212PI_COOKIE_SAME_SITE=strict
T212PI_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
T212PI_ALLOWED_HOSTS=["127.0.0.1","localhost"]
T212PI_ISSUER=
T212PI_AUDIENCE=
T212PI_JWT_PUBLIC_KEY_REFERENCE=
T212PI_SESSION_SIGNING_KEY_REFERENCE=
# Production must explicitly set T212PI_CREDENTIAL_BACKEND=external and compose
# the corresponding secret-manager adapter.

# Worker/provider. Synthetic is the safe local default. The credential bundle
# must be strict JSON at runtime and remains blank here. The Demo smoke requires
# its independent explicit execution gate; the script has no Live path.
T212PI_WORKER_PROVIDER=synthetic
T212PI_WORKER_EAGER=false
T212PI_RATE_COORDINATION_URL=redis://127.0.0.1:6379/2
T212PI_TRADING212_ENVIRONMENT=demo
T212PI_TRADING212_LIVE_ENABLED=false
T212PI_TRADING212_CREDENTIAL_BUNDLE=
T212PI_RUN_TRADING212_DEMO_SMOKE=0

# API/MCP/web ports and server-side routing. Never expose local synthetic MCP
# authentication through a public tunnel.
API_PORT=8000
MCP_PORT=8001
WEB_PORT=3000
T212PI_MCP_HOST=127.0.0.1
T212PI_MCP_PORT=8001
T212PI_MCP_ALLOW_NON_LOOPBACK_LOCAL_SYNTHETIC_BIND=false
# Set T212PI_MCP_PUBLIC_BASE_URL and T212PI_MCP_WIDGET_DOMAIN only to reviewed
# HTTPS origins in an authenticated deployment; an empty URL is invalid.
T212PI_API_BASE_URL=http://127.0.0.1:8000
T212PI_LOCAL_API_AUTH_ENABLED=1
T212PI_WEB_ENVIRONMENT=local
T212PI_ACCOUNT_ID=
PORTFOLIO_DEMO_MODE=0

# Optional telemetry integration points. They must never receive credentials,
# authorization headers, cookies, or raw private provider payloads.
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_REPORTING_DSN=
