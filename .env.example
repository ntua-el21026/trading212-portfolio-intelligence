# Copy to .env for local development. Never commit real values.

APP_ENV=local
APP_LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio
REDIS_URL=redis://localhost:6379/0

# Local development uses the synthetic provider by default.
BROKER_PROVIDER=mock
TRADING212_ENV=demo
TRADING212_API_KEY=
TRADING212_API_SECRET=

# Production authentication must be explicitly configured; local synthetic
# authentication must fail closed outside local/test.
AUTH_MODE=local
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

MCP_PUBLIC_URL=
MCP_AUTH_MODE=local

REPORTING_CURRENCY=EUR

# Telemetry endpoints are optional locally and must never receive secrets.
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_REPORTING_DSN=
